{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Spike Coach",
    "version": "1.0.1",
    "minimum-overwolf-version": "0.199.0.15",
    "author": "Kireeti Saha",
    "icon": "IconMouseOver.png",
    "icon_gray": "IconMouseNormal.png",
    "description": "Valorant Coacher",
    "window_icon": "Spikecoach_Final_Logo.png"
  },
  "permissions": ["GameInfo"],
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21640]
    },
    "game_events": [21640],
    "start_window": "MainWindow",
    "windows": {
      "MainWindow": {
        "file": "index.html",
        "transparent": false,
        "resizable": true,
        "use_os_windowing": true,
        "size": {
          "width": 1280,
          "height": 800
        },
        "min_size": {
          "width": 1024,
          "height": 600
        }
      },
      "ProductWindow": {
        "file": "product.html",
        "transparent": false,
        "resizable": true,
        "use_os_windowing": true,
        "size": {
          "width": 1280,
          "height": 800
        },
        "min_size": {
          "width": 1024,
          "height": 600
        }
      },
      "SpikeCoachTab": {
        "file": "spikecoach-tab.html",
        "transparent": false,
        "resizable": false,
        "grab_keyboard_focus": false,
        "size": {
          "width": 688,
          "height": 512
        },
        "min_size": {
          "width": 688,
          "height": 512
        },
        "max_size": {
          "width": 688,
          "height": 512
        }
      }
    }
  }
}
