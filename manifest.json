{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Spike Coach",
    "version": "1.0.1",
    "minimum-overwolf-version": "0.199.0.15",
    "author": "Kireeti Saha",
    "icon": "IconMouseOver.png",
    "icon_gray": "IconMouseNormal.png",
    "description": "Valorant Coacher",
    "window_icon": "Spikecoach_Final_Logo.png"
  },
  "permissions": ["GameInfo", "Hotkeys"],
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21640]
    },
    "game_events": [21640],
    "start_window": "MainWindow",
    "request_referrer_force": [
      {
        "rule": "https://www.youtube.com/*",
        "domain": "spike-coach"
      },
      {
        "rule": "https://*.youtube.com/*",
        "domain": "spike-coach"
      },
      {
        "rule": "https://*.youtube-nocookie.com/*",
        "domain": "spike-coach"
      }
    ],
    "externally_connectable": {
      "matches": [
        "https://spikecoach-api.onrender.com"
      ]
    },
    "hotkeys": {
      "toggle_spikecoach": {
        "title": "SpikeCoach Overlay",
        "action-type": "custom",
        "default": "Ctrl+Shift+K",
        "passthrough": true,
        "game_ids": [21640]
      }
    },
    "windows": {
      "MainWindow": {
        "file": "index.html",
        "transparent": false,
        "resizable": true,
        "use_os_windowing": true,
        "size": {
          "width": 1280,
          "height": 800
        },
        "min_size": {
          "width": 1024,
          "height": 600
        }
      },
      "ProductWindow": {
        "file": "product.html",
        "transparent": false,
        "resizable": true,
        "use_os_windowing": true,
        "size": {
          "width": 1280,
          "height": 800
        },
        "min_size": {
          "width": 1024,
          "height": 600
        }
      },
      "SpikeCoachTab": {
        "file": "spikecoach-tab.html",
        "transparent": false,
        "resizable": true,
        "grab_keyboard_focus": false,
        "size": {
          "width": 688,
          "height": 770
        },
        "min_size": {
          "width": 688,
          "height": 420
        },
        "max_size": {
          "width": 688,
          "height": 770
        }
      }
    }
  }
}
